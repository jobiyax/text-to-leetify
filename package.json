{
	"name": "bale-live",
	"module": "index.ts",
	"type": "module",
	"private": true,
	"scripts": {
		"help": "bun run scripts/build.ts --help",
		"dev": "bun --hot server",
		"build": "bun run scripts/build.ts",
		"start": "NODE_ENV=production bun server",
		"format": "biome format --write .",
		"lint": "biome lint --write .",
		"check": "biome check --write .",
		"fix": "biome check . --write --unsafe",
		"generate": "bunx drizzle-kit generate",
		"migrate": "bunx drizzle-kit migrate"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/bun": "latest",
		"@types/pg": "^8.20.0",
		"drizzle-kit": "^0.31.10",
		"tsx": "^4.22.1"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"bun-plugin-tailwind": "^0.1.2",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"pg": "^8.21.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"tailwindcss": "^4.3.0",
		"zod": "^4.4.3"
	}
}
